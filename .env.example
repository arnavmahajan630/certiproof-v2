# Read automatically by `docker compose` (looked up next to docker-compose.yml).
# Copy to .env and fill in before `docker compose up`. Not used by local
# (non-Docker) dev -- that reads gateway/.env and ml-worker/.env instead.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Must match whatever host:port the frontend is actually reachable at -- only
# affects the QR code embedded in scorecard PDFs (the re-upload verify flow
# doesn't depend on it, see docs/api_contract.md).
PUBLIC_BASE_URL=http://localhost:5173
